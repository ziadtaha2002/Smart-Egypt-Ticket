@model Smart_Egypt_Ticket.DTO.RegisterUserDTO

@{
    ViewData["Title"] = "Create Account";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <div class="brand-icon">
                <i class="bi bi-person-plus"></i>
            </div>

            <h1>Create Account</h1>
            <p>Join Smart Egypt Ticket today</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email address"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Create a password"
                           autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('Password', 'passwordIcon1')"
                            aria-label="Show or hide password">
                        <i id="passwordIcon1" class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm your password"
                           autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('ConfirmPassword', 'passwordIcon2')"
                            aria-label="Show or hide password">
                        <i id="passwordIcon2" class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="form-label">FullName</label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone"></i>
                    <input asp-for="FullName"
                           class="form-control"
                           autocomplete="tel" />
                </div>
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn login-button mt-4">
                <i class="bi bi-person-plus me-2"></i>
                Create Account
            </button>
        </form>

        <div class="register-link">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Sign in</a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* نفس الستايلات اللي في صفحة اللوجين بالظبط */
        .login-page {
            min-height: calc(100vh - 120px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 15px;
            background: linear-gradient(135deg, #f4f8fb, #e8f1f7);
        }

        .login-card {
            width: 100%;
            max-width: 480px; /* كبرتها شوية عشان حقول التسجيل أكتر */
            padding: 40px;
            background-color: #ffffff;
            border-radius: 18px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .brand-icon {
            width: 68px;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            color: #ffffff;
            font-size: 30px;
            background: linear-gradient(135deg, #087f8c, #005f73);
            border-radius: 50%;
        }

        .login-header h1 {
            margin-bottom: 8px;
            color: #17324d;
            font-size: 28px;
            font-weight: 700;
        }

        .login-header p {
            margin: 0;
            color: #718096;
        }

        .form-label {
            color: #2d3748;
            font-weight: 600;
        }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper > i {
                position: absolute;
                top: 50%;
                left: 15px;
                z-index: 2;
                color: #087f8c;
                transform: translateY(-50%);
            }

            .input-wrapper .form-control {
                min-height: 48px;
                padding-left: 45px;
                border: 1px solid #d9e2ec;
                border-radius: 9px;
            }

                .input-wrapper .form-control:focus {
                    border-color: #087f8c;
                    box-shadow: 0 0 0 0.2rem rgba(8, 127, 140, 0.15);
                }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 14px;
            padding: 0;
            color: #718096;
            background: transparent;
            border: 0;
            transform: translateY(-50%);
        }

            .password-toggle:hover {
                color: #087f8c;
            }

        .login-button {
            width: 100%;
            min-height: 50px;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            background: linear-gradient(135deg, #087f8c, #005f73);
            border: 0;
            border-radius: 9px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .login-button:hover {
                color: #ffffff;
                transform: translateY(-2px);
                box-shadow: 0 7px 18px rgba(8, 127, 140, 0.3);
            }

        .register-link {
            margin-top: 25px;
            color: #718096;
            text-align: center;
            font-size: 14px;
        }

            .register-link a {
                color: #087f8c;
                font-weight: 600;
                text-decoration: none;
            }

                .register-link a:hover {
                    color: #005f73;
                    text-decoration: underline;
                }

        .text-danger {
            display: block;
            margin-top: 5px;
            font-size: 13px;
        }

        @@media (max-width: 576px) {
            .login-card {
                padding: 30px 22px;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const passwordIcon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                passwordIcon.className = "bi bi-eye-slash";
            } else {
                passwordInput.type = "password";
                passwordIcon.className = "bi bi-eye";
            }
        }
    </script>
}