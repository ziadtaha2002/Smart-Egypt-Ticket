@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

<h1>Roles</h1>

<a asp-action="Create" class="btn btn-primary">Create Role</a>

<table class="table">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Normalized Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.NormalizedName</td>
            </tr>
        }
    </tbody>
</table>